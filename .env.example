# Public build-time configuration. Rebuild after changing these.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ISG_TEAM_EMAIL=
CRON_SECRET=

# Keep off until privacy/business review and service setup are complete.
INTAKE_ENABLED=false
# Advisor enquiries are independent of consultation/payment intake. Set false to pause.
CONTACT_ENABLED=true
# Enable only behind a proxy that replaces (not appends untrusted) forwarded IPs.
TRUST_PROXY=false
APP_PORT=3002
